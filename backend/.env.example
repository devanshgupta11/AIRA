# AIRA - Gemini configuration TEMPLATE. Copy to backend/.env and paste your keys there.
#
# Paste one key per line. IMPORTANT: create each key in a DIFFERENT Google Cloud project
# (AI Studio -> "Create API key" -> "Create API key in new project"). Gemini's free-tier limits
# apply per project, so keys from the same project share one quota and failing over between them
# gains nothing.
#
# Any number of keys works; blank lines are ignored. Keys are tried in order 1, 2, 3...: AIRA stays
# on a key until Gemini rate-limits it, then moves to the next.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# The model every agent uses (CrewAI and ADK alike). Check that it is listed for your keys at
# https://aistudio.google.com before changing it.
AIRA_GEMINI_MODEL=gemini-3.5-flash

# Failover tuning (seconds). Defaults shown.
# Rest for a rate-limited key when Gemini's reply does not say how long to wait:
AIRA_LLM_COOLDOWN_S=60
# Rest for a key that hit its DAILY quota:
AIRA_LLM_DAY_COOLDOWN_S=3600
# Longest one call will wait when every key is cooling down, before failing honestly:
AIRA_LLM_MAX_WAIT_S=60
