# AIRA overrides for the OpenTelemetry Demo, loaded after upstream .env and .env.override.
# Pins the demo images to the release we cloned (upstream .env uses DEMO_VERSION=latest).
DEMO_VERSION=3.1.0
IMAGE_VERSION=3.1.0

# Collector extras layer (relative to the opentelemetry-demo project directory).
OTEL_COLLECTOR_CONFIG_EXTRAS=../infra/otelcol-config-extras.yml
